<!--
  VOX 2.0 colour tokens (see README.md in this folder).
  Starting point for src/Vox.App: take the "Light" or "Dark" dictionary below, add it to
  Application.Resources.MergedDictionaries on top of WPF's Fluent theme
  (Application.ThemeMode="System") and swap it when Windows switches theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="VoxAccent">#0062F5</Color>
      <Color x:Key="VoxAccentText">#FFFFFF</Color>
      <Color x:Key="VoxWindowBackground">#F5FAFD</Color>
      <Color x:Key="VoxCardBackground">#FFFFFF</Color>
      <Color x:Key="VoxCardStroke">#E3EBF5</Color>
      <Color x:Key="VoxSelectedFill">#E2EDFC</Color>
      <Color x:Key="VoxNavSelectedFill">#D1E3FB</Color>
      <Color x:Key="VoxProgressTrack">#DBE8F7</Color>
      <Color x:Key="VoxTextPrimary">#0B1630</Color>
      <Color x:Key="VoxTextSecondary">#5B6B84</Color>
      <Color x:Key="VoxSuccess">#0F7B0F</Color>
      <Color x:Key="VoxWarning">#F2C200</Color>
    </ResourceDictionary>

    <!-- Dark -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="VoxAccent">#60CDFF</Color>
      <Color x:Key="VoxAccentText">#00243A</Color>
      <Color x:Key="VoxWindowBackground">#141D28</Color>
      <Color x:Key="VoxCardBackground">#1B222D</Color>
      <Color x:Key="VoxCardStroke">#2A3341</Color>
      <Color x:Key="VoxSelectedFill">#16304A</Color>
      <Color x:Key="VoxNavSelectedFill">#1F2C3D</Color>
      <Color x:Key="VoxProgressTrack">#2A3341</Color>
      <Color x:Key="VoxTextPrimary">#FFFFFF</Color>
      <Color x:Key="VoxTextSecondary">#B6C2D3</Color>
      <Color x:Key="VoxSuccess">#6CCB5F</Color>
      <Color x:Key="VoxWarning">#FCE100</Color>
    </ResourceDictionary>


  <!-- Theme-independent -->
  <Color x:Key="VoxRecording">#FF4D4F</Color>
  <Color x:Key="VoxPillBackground">#EB1E2636</Color>
  <Color x:Key="VoxBrandNavy">#0B1630</Color>
  <Color x:Key="VoxBrandBlue">#0866FD</Color>

  <CornerRadius x:Key="VoxRadiusWindow">8</CornerRadius>
  <CornerRadius x:Key="VoxRadiusCard">8</CornerRadius>
  <CornerRadius x:Key="VoxRadiusControl">6</CornerRadius>

  <FontFamily x:Key="VoxFontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="VoxFontText">Segoe UI Variable Text, Segoe UI</FontFamily>
</ResourceDictionary>
