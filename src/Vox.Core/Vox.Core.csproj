<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vox.Core</RootNamespace>
    <!-- ModelFiles: GetFinalPathNameByHandleW through LibraryImport. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vox.Core.Tests" />
    <EmbeddedResource Include="Text\Data\terms.json" LogicalName="Vox.Core.terms.json" />
    <EmbeddedResource Include="Text\Data\no-declension.json" LogicalName="Vox.Core.no-declension.json" />
    <EmbeddedResource Include="Text\Data\brands.txt" LogicalName="Vox.Core.brands.txt" />
    <EmbeddedResource Include="Text\Data\common-words.txt.gz" LogicalName="Vox.Core.common-words.txt.gz" />
    <EmbeddedResource Include="Text\Data\english.txt.gz" LogicalName="Vox.Core.english.txt.gz" />
    <EmbeddedResource Include="Text\Data\ru_RU.dic.gz" LogicalName="Vox.Core.ru_RU.dic.gz" />
    <EmbeddedResource Include="Text\Data\ru_RU.aff.gz" LogicalName="Vox.Core.ru_RU.aff.gz" />
  </ItemGroup>
  <!-- License notices: copied to licenses\ next to every program that uses Vox.Core, so the installer
       ships them with Vox.exe (Vox.Core.Licenses, Settings → «Помощь» → «Лицензии»). The files are the
       repository's own, as .txt so that they open in Notepad. Vox.App adds the .NET ones when publishing. -->
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="licenses\Vox-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="licenses\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Text\Data\*.LICENSE.md" Link="licenses\%(Filename).txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Vox.App\Assets\Fonts\OFL-GolosText.txt" Link="licenses\OFL-GolosText.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
