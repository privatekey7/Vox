<Window x:Class="Vox.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Vox" Width="900" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Style="{StaticResource Vox.Window}"
        Icon="pack://application:,,,/Assets/vox.ico">
  <!-- docs/design/v2/ui-5-settings.jpg, ui-6-history-dark.jpg -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navigation -->
    <StackPanel Margin="12,16,12,16">
      <RadioButton x:Name="NavGeneral" Content="Основное" Tag="&#xE713;" Style="{StaticResource Vox.NavItem}" GroupName="nav" Checked="OnNav"/>
      <RadioButton x:Name="NavHistory" Content="История" Tag="&#xE81C;" Style="{StaticResource Vox.NavItem}" GroupName="nav" Checked="OnNav"/>
      <RadioButton x:Name="NavDictionary" Content="Словарь" Tag="&#xE82D;" Style="{StaticResource Vox.NavItem}" GroupName="nav" Checked="OnNav"/>
      <RadioButton x:Name="NavHelp" Content="Помощь" Tag="&#xE897;" Style="{StaticResource Vox.NavItem}" GroupName="nav" Checked="OnNav"/>
    </StackPanel>

    <!-- General -->
    <ScrollViewer x:Name="PageGeneral" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20,32,24">
      <StackPanel>
        <TextBlock Text="Основное" Style="{StaticResource Vox.Section}" Margin="0,0,0,16"/>
        <Border Style="{StaticResource Vox.Card}" Padding="0">
          <StackPanel>
            <Grid Margin="16,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE765;" Style="{StaticResource Vox.Icon}" Margin="0,0,16,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Клавиша для записи" Style="{StaticResource Vox.Body}"/>
                <TextBlock Text="Зажмите и говорите" Style="{StaticResource Vox.Caption}"/>
              </StackPanel>
              <ComboBox x:Name="HotkeyBox" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="OnHotkeyChanged"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource Vox.CardStroke}"/>
            <Grid Margin="16,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE774;" Style="{StaticResource Vox.Icon}" Margin="0,0,16,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Язык речи" Style="{StaticResource Vox.Body}"/>
                <TextBlock x:Name="LanguageHint" Text="Модель скачается автоматически" Style="{StaticResource Vox.Caption}"/>
                <ProgressBar x:Name="LanguageProgress" Style="{StaticResource Vox.Progress}" Maximum="1" Margin="0,6,24,0"
                             Visibility="Collapsed"/>
              </StackPanel>
              <ComboBox x:Name="LanguageBox" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="OnLanguageChanged"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource Vox.CardStroke}"/>
            <Grid Margin="16,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE720;" Style="{StaticResource Vox.Icon}" Margin="0,0,16,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Микрофон" Style="{StaticResource Vox.Body}"/>
                <TextBlock x:Name="MicHint" Text="Скажите что-нибудь, проверю, слышно ли вас" Style="{StaticResource Vox.Caption}"/>
              </StackPanel>
              <ComboBox x:Name="MicBox" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="OnMicChanged"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Vox.Card}" Padding="0" Margin="0,12,0,0">
          <StackPanel>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Звуки начала и конца записи" Style="{StaticResource Vox.Body}" VerticalAlignment="Center"/>
              <CheckBox x:Name="SoundsToggle" Grid.Column="1" Style="{StaticResource Vox.Toggle}" Click="OnToggle"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource Vox.CardStroke}"/>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource Vox.Body}" VerticalAlignment="Center"/>
              <CheckBox x:Name="AutostartToggle" Grid.Column="1" Style="{StaticResource Vox.Toggle}" Click="OnToggle"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource Vox.CardStroke}"/>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Сохранять мой буфер обмена" Style="{StaticResource Vox.Body}"/>
                <TextBlock Text="После вставки вернуть то, что я копировал" Style="{StaticResource Vox.Caption}"/>
              </StackPanel>
              <CheckBox x:Name="ClipboardToggle" Grid.Column="1" Style="{StaticResource Vox.Toggle}" Click="OnToggle"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- History -->
    <Grid x:Name="PageHistory" Grid.Column="1" Margin="24,20,32,24" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid>
        <TextBlock Text="История" Style="{StaticResource Vox.Section}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="Открыть логи" Style="{StaticResource Vox.SecondaryButton}" Click="OnOpenLogs" Margin="0,0,16,0"/>
          <Button Content="Очистить" Style="{StaticResource Vox.LinkButton}" VerticalAlignment="Center" Click="OnClearHistory"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,16,0,12">
        <TextBox x:Name="SearchBox" FontSize="14" Padding="34,8,8,8" TextChanged="OnSearchChanged"/>
        <TextBlock Text="&#xE721;" Style="{StaticResource Vox.Icon}" FontSize="14" Margin="12,0,0,0" IsHitTestVisible="False"/>
        <TextBlock x:Name="SearchPlaceholder" Text="Найти в диктовках…" Style="{StaticResource Vox.Subtitle}" Margin="35,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="HistoryList"/>
      </ScrollViewer>
    </Grid>

    <!-- Dictionary -->
    <Grid x:Name="PageDictionary" Grid.Column="1" Margin="24,20,32,24" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Словарь" Style="{StaticResource Vox.Section}"/>
      <StackPanel Grid.Row="1" Margin="0,8,0,16">
        <TextBlock Style="{StaticResource Vox.Subtitle}"
                   Text="Если Vox пишет слово неправильно, добавьте замену, и дальше он будет писать его как нужно."/>
        <Border Style="{StaticResource Vox.Card}" Margin="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Учиться на моих исправлениях" Style="{StaticResource Vox.Body}"/>
              <TextBlock Text="Исправьте слово после диктовки, и Vox сразу запомнит замену. Не запомнил: нажмите Ctrl+S сразу после правки. Запомнил не то: меню Vox в трее → «Отменить последнее запоминание»" Style="{StaticResource Vox.Caption}"/>
            </StackPanel>
            <CheckBox x:Name="LearnToggle" Grid.Column="1" Style="{StaticResource Vox.Toggle}" Click="OnToggle"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource Vox.Card}" Margin="0,8,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Подсказки с экрана: Vox учитывает названия из открытых окон" Style="{StaticResource Vox.Body}"/>
              <TextBlock Text="Названия из заголовков окон помогают писать их правильно. Хранятся только отдельные слова, на этом компьютере." Style="{StaticResource Vox.Caption}"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="ScreenMemoryButton" Content="Что Vox запомнил с экрана" Style="{StaticResource Vox.LinkButton}" Click="OnShowScreenMemory"/>
                <Button Content="Очистить память названий" Style="{StaticResource Vox.LinkButton}" Margin="16,0,0,0" Click="OnClearScreenMemory"/>
              </StackPanel>
            </StackPanel>
            <CheckBox x:Name="ScreenToggle" Grid.Column="1" Style="{StaticResource Vox.Toggle}" Click="OnToggle"/>
            <!-- Under the toggle, the card's full width; its own scroll: the cards above the dictionary
                 do not scroll with the page. -->
            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding Visibility, ElementName=ScreenMemoryList}"
                          MaxHeight="220" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ScreenMemoryList" Visibility="Collapsed"/>
            </ScrollViewer>
          </Grid>
        </Border>
        <Border Style="{StaticResource Vox.Card}" Margin="0,8,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Читать текст активного окна" Style="{StaticResource Vox.Body}"/>
              <TextBlock Text="Названия из окна, где вы диктуете: страницы, переписки, документа. Поле ввода и поля паролей не читаются, сам текст не сохраняется, только отдельные названия." Style="{StaticResource Vox.Caption}"/>
            </StackPanel>
            <CheckBox x:Name="ScreenTextToggle" Grid.Column="1" Style="{StaticResource Vox.Toggle}" Click="OnToggle"/>
          </Grid>
        </Border>
      </StackPanel>
      <Border Grid.Row="2" Style="{StaticResource Vox.Card}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Vox пишет" Style="{StaticResource Vox.Caption}" Margin="0,0,0,4"/>
            <TextBox x:Name="WrongBox" FontSize="14" Padding="8,6"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="&#xE72A;" Style="{StaticResource Vox.Icon}" Margin="12,18,12,0"/>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Как надо" Style="{StaticResource Vox.Caption}" Margin="0,0,0,4"/>
            <TextBox x:Name="CorrectBox" FontSize="14" Padding="8,6"/>
          </StackPanel>
          <Button Grid.Column="3" Content="Добавить" Style="{StaticResource Vox.PrimaryButton}" Margin="12,18,0,0"
                  VerticalAlignment="Top" Click="OnAddWord"/>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DictionaryList"/>
      </ScrollViewer>
    </Grid>

    <!-- Help -->
    <ScrollViewer x:Name="PageHelp" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20,32,24" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="Помощь" Style="{StaticResource Vox.Section}" Margin="0,0,0,16"/>
        <Border Style="{StaticResource Vox.Card}" Padding="20">
          <StackPanel>
            <TextBlock Text="Как пользоваться" Style="{StaticResource Vox.Question}" Margin="0,0,0,8"/>
            <TextBlock x:Name="HowTo" Style="{StaticResource Vox.Body}" LineHeight="22"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Vox.Card}" Padding="20" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Если что-то не работает" Style="{StaticResource Vox.Question}" Margin="0,0,0,8"/>
            <TextBlock Style="{StaticResource Vox.Body}" LineHeight="22"
                       Text="• Текст не вставился: нажмите Ctrl+V или возьмите его в «Истории».&#10;• «Не расслышал»: говорите ближе к микрофону или выберите другой микрофон в «Основном».&#10;• Клавиша не срабатывает в программе, запущенной от администратора: Windows запрещает это обычным программам.&#10;• Vox запоминает исправления в большинстве программ (Блокнот, Word, браузер, Telegram, Notepad++). Некоторые программы не дают прочитать свой текст (часть редакторов кода, игры), там слово можно добавить вручную в «Словаре». Автозамену программ и слова короче 3 букв Vox не запоминает."/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Открыть логи" Style="{StaticResource Vox.SecondaryButton}" Click="OnOpenLogs"/>
              <Button Content="Папка с моделями" Style="{StaticResource Vox.SecondaryButton}" Margin="10,0,0,0" Click="OnOpenModels"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Vox.Card}" Padding="20" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Перенос на другой компьютер" Style="{StaticResource Vox.Question}" Margin="0,0,0,8"/>
            <TextBlock Style="{StaticResource Vox.Caption}" TextWrapping="Wrap"
                       Text="Словарь, выученные исправления, настройки и названия программ и сайтов из заголовков окон в одном файле. Файл личный, не отправляйте его другим людям. На другом компьютере загрузите его: данные добавятся к тем, что уже есть, ничего не пропадёт."/>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Вместе с историей диктовок" Style="{StaticResource Vox.Body}" VerticalAlignment="Center"/>
              <CheckBox x:Name="TransferHistoryToggle" Grid.Column="1" Style="{StaticResource Vox.Toggle}" IsChecked="True"/>
            </Grid>
            <Grid x:Name="TransferRecordingsRow" Margin="0,8,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TransferRecordingsText" Text="Вместе с записями звука" Style="{StaticResource Vox.Body}" VerticalAlignment="Center"/>
              <CheckBox x:Name="TransferRecordingsToggle" Grid.Column="1" Style="{StaticResource Vox.Toggle}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Сохранить в файл…" Style="{StaticResource Vox.SecondaryButton}" Click="OnExportData"/>
              <Button Content="Загрузить из файла…" Style="{StaticResource Vox.SecondaryButton}" Margin="10,0,0,0" Click="OnImportData"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Button x:Name="DeveloperButton" Content="Для разработчика" Style="{StaticResource Vox.LinkButton}" HorizontalAlignment="Left" Margin="4,16,0,0" Click="OnShowDeveloper"/>
        <Border x:Name="DeveloperCard" Style="{StaticResource Vox.Card}" Margin="0,8,0,0" Visibility="Collapsed">
          <Grid Margin="16,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Сохранять записи диктовок" Style="{StaticResource Vox.Body}"/>
              <TextBlock Text="Для проверки распознавания. Записи хранятся только на этом компьютере." Style="{StaticResource Vox.Caption}"/>
              <Button Content="Открыть папку с записями" Style="{StaticResource Vox.LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnOpenRecordings"/>
            </StackPanel>
            <CheckBox x:Name="RecordingsToggle" Grid.Column="1" Style="{StaticResource Vox.Toggle}" Click="OnToggle"/>
          </Grid>
        </Border>
        <TextBlock x:Name="VersionText" Style="{StaticResource Vox.Caption}" Margin="4,16,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
