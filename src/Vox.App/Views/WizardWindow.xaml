<Window x:Class="Vox.App.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vox" Width="640" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource Vox.Window}"
        Icon="pack://application:,,,/Assets/vox.ico">
  <!-- First run: 1) language  2) download  3) try it. docs/design/v2/ui-1..3 -->
  <Grid Margin="40,28,40,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Image Source="pack://application:,,,/Assets/vox-symbol.png" Width="88" Height="88" Margin="0,0,0,12"
           RenderOptions.BitmapScalingMode="HighQuality"/>

    <!-- Step 1: language -->
    <StackPanel x:Name="StepLanguage" Grid.Row="1">
      <TextBlock Text="Привет! Я Vox" Style="{StaticResource Vox.Title}" HorizontalAlignment="Center"/>
      <TextBlock Style="{StaticResource Vox.Subtitle}" TextAlignment="Center" Margin="0,8,0,24" FontSize="15"
                 Text="Говорите, и текст появится там, где стоит курсор. В любой программе, без интернета."/>
      <TextBlock Text="На каком языке вы будете говорить?" Style="{StaticResource Vox.Question}"
                 HorizontalAlignment="Center" Margin="0,0,0,14"/>
      <RadioButton x:Name="ChoiceRussian" Style="{StaticResource Vox.ChoiceCard}" GroupName="lang" IsChecked="True">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Русский" Style="{StaticResource Vox.Question}"/>
            <Border Background="{DynamicResource Vox.Accent}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="рекомендуем" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Vox.AccentText}"/>
            </Border>
          </StackPanel>
          <TextBlock Style="{StaticResource Vox.Caption}" Margin="0,4,0,0"
                     Text="Точно понимает русскую речь, сам ставит запятые и пишет числа цифрами"/>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="ChoiceOther" Style="{StaticResource Vox.ChoiceCard}" GroupName="lang">
        <StackPanel>
          <TextBlock Text="English и другие европейские" Style="{StaticResource Vox.Question}"/>
          <TextBlock Style="{StaticResource Vox.Caption}" Margin="0,4,0,0" Text="25 языков, включая русский"/>
        </StackPanel>
      </RadioButton>
    </StackPanel>

    <!-- Step 2: download -->
    <StackPanel x:Name="StepDownload" Grid.Row="1" Visibility="Collapsed">
      <TextBlock Text="Готовлю распознавание речи" Style="{StaticResource Vox.Title}" HorizontalAlignment="Center"/>
      <TextBlock Style="{StaticResource Vox.Subtitle}" TextAlignment="Center" Margin="0,8,0,24" FontSize="15"
                 Text="Это нужно один раз. Потом Vox работает без интернета."/>
      <Border Style="{StaticResource Vox.Card}" Padding="20">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" Style="{StaticResource Vox.Icon}" Margin="0,0,10,0"/>
            <TextBlock x:Name="DownloadTitle" Text="Скачиваю модель" Style="{StaticResource Vox.Question}" FontSize="15"/>
          </StackPanel>
          <ProgressBar x:Name="DownloadBar" Style="{StaticResource Vox.Progress}" Margin="0,14,0,10" Maximum="1"/>
          <TextBlock x:Name="DownloadBytes" Style="{StaticResource Vox.Body}"/>
          <TextBlock x:Name="DownloadEta" Style="{StaticResource Vox.Caption}" Margin="0,2,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Step 3: try it -->
    <StackPanel x:Name="StepTry" Grid.Row="1" Visibility="Collapsed">
      <TextBlock Text="Попробуйте прямо сейчас" Style="{StaticResource Vox.Title}" HorizontalAlignment="Center"/>
      <TextBlock Style="{StaticResource Vox.Subtitle}" TextAlignment="Center" Margin="0,8,0,20" FontSize="15"
                 Text="Зажмите клавишу, скажите «Привет, Vox» и отпустите."/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
        <Border CornerRadius="10" BorderThickness="1,1,1,4" BorderBrush="{DynamicResource Vox.CardStroke}"
                Background="{DynamicResource Vox.CardBackground}" Padding="26,14" MinWidth="150">
          <TextBlock x:Name="KeyCap" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource Vox.TextPrimary}"/>
        </Border>
        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
          <Button x:Name="ChangeKeyLink" Content="Сменить клавишу" Style="{StaticResource Vox.LinkButton}" Click="OnChangeKey"/>
          <ComboBox x:Name="KeyPicker" Visibility="Collapsed" MinWidth="170" Margin="0,6,0,0" SelectionChanged="OnKeyPicked"/>
        </StackPanel>
      </StackPanel>
      <TextBox x:Name="TryBox" FontSize="16" MinHeight="48" Padding="10,10" TextWrapping="Wrap"/>
      <StackPanel x:Name="TrySuccess" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
        <TextBlock Text="&#xE73E;" Style="{StaticResource Vox.Icon}" Foreground="{DynamicResource Vox.Success}" FontSize="14" Margin="0,0,8,0"/>
        <TextBlock Text="Отлично, всё работает!" Foreground="{DynamicResource Vox.Success}" FontWeight="SemiBold"/>
      </StackPanel>
    </StackPanel>

    <!-- Footer: steps + buttons -->
    <Grid Grid.Row="2" Margin="0,28,0,0">
      <StackPanel x:Name="Steps" Orientation="Horizontal" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource Vox.SecondaryButton}" Click="OnCancel"
                Visibility="Collapsed"/>
        <Button x:Name="NextButton" Content="Продолжить" Style="{StaticResource Vox.PrimaryButton}" Click="OnNext"
                Margin="10,0,0,0" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
