<!-- VOX 2.0 colours, Light theme (docs/design/v2/README.md). Swapped at runtime by ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Vox.Accent" Color="#0062F5"/>
  <SolidColorBrush x:Key="Vox.AccentText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Vox.WindowBackground" Color="#F5FAFD"/>
  <SolidColorBrush x:Key="Vox.CardBackground" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Vox.CardHover" Color="#F0F5FB"/>
  <SolidColorBrush x:Key="Vox.CardStroke" Color="#E3EBF5"/>
  <SolidColorBrush x:Key="Vox.SelectedFill" Color="#E2EDFC"/>
  <SolidColorBrush x:Key="Vox.NavSelectedFill" Color="#D1E3FB"/>
  <SolidColorBrush x:Key="Vox.ProgressTrack" Color="#DBE8F7"/>
  <SolidColorBrush x:Key="Vox.TextPrimary" Color="#0B1630"/>
  <SolidColorBrush x:Key="Vox.TextSecondary" Color="#5B6B84"/>
  <SolidColorBrush x:Key="Vox.Success" Color="#0F7B0F"/>
  <SolidColorBrush x:Key="Vox.Warning" Color="#C79A00"/>
</ResourceDictionary>
